generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  nom            String
  prenom         String
  email          String   @unique
  date_naissance DateTime
  password       String
  role           String
  position       String
  department     String
  hireDate       DateTime
  profile        Profile?

  // 👉 formations créées (trainer)
  createdFormations Formation[] @relation("TrainerFormations")

  // 👉 assignations
  assignments Assignment[]
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Formation {
  id       Int    @id @default(autoincrement())
  title    String
  duration String

  trainerId Int
  trainer   User @relation("TrainerFormations", fields: [trainerId], references: [id])

  status String   @default("Planned")
  date   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 👉 assignations
  assignments Assignment[]
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Assignment {
  id          Int              @id @default(autoincrement())
  userId      Int
  formationId Int
  status      AssignmentStatus @default(NOT_STARTED)

  user      User      @relation(fields: [userId], references: [id])
  formation Formation @relation(fields: [formationId], references: [id])
}

model Career {
  id          Int     @id @default(autoincrement())
  title       String
  position    String
  department  String
  baseSalary  Int
  level       Int?
  description String?

  createdAt DateTime @default(now())
}

model Profile {
  id    Int     @id @default(autoincrement())
  photo String?
  cv    String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}
